# Copy to .env if you want to change anything (all optional)
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to allow phones on your Wi-Fi (then set a PIN first!)
HOST=127.0.0.1
# Where the database and backups live
DATA_DIR=./data
BACKUP_DIR=./backups
# Optional PIN protecting every request (leave empty for none)
APP_PIN=
